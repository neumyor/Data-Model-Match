{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodelmatch.invalid/schemas/governance/requirement-status-ledger-1.json",
  "title": "Signable requirement status ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ledgerId", "baselineId", "requirements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ledgerId": {
      "type": "string",
      "pattern": "^requirement_status_ledger_[a-z0-9_]+$"
    },
    "baselineId": {
      "type": "string",
      "pattern": "^governance_baseline_[a-z0-9_]+$"
    },
    "requirements": {
      "type": "array",
      "minItems": 30,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "state"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "state": { "enum": ["VERIFIED", "PENDING", "BLOCKED"] }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "requirementType",
        "status",
        "owner",
        "independentAcceptor",
        "inputArtifacts",
        "outputArtifacts",
        "acceptanceEvidence"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "pattern": "^(SRC-(0[1-9]|1[0-9]|2[0-3])|DER-0[1-7])$"
        },
        "requirementType": {
          "enum": ["SOURCE_REQUIREMENT", "DERIVED_PRODUCT_REQUIREMENT"]
        },
        "status": {
          "enum": ["PLANNED", "IN_PROGRESS", "BLOCKED", "PASSED", "SUPERSEDED"]
        },
        "owner": { "type": "string", "minLength": 1 },
        "independentAcceptor": { "type": "string", "minLength": 1 },
        "inputArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "outputArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "acceptanceEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    }
  }
}
