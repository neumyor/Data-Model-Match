{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodelmatch.invalid/schemas/governance/frozen-contract-surface-1.json",
  "title": "Frozen semantic contract surface",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surfaceId", "coverageRoots", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "surfaceId": {
      "type": "string",
      "pattern": "^frozen_contract_surface_[a-z0-9_]+$"
    },
    "coverageRoots": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(docs/semantic-contracts|tests/semantic_contracts)$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(docs/semantic-contracts|tests/semantic_contracts)/[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
