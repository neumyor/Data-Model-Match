{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodelmatch.local/schemas/semantic/v1/schema-catalog.json",
  "title": "Semantic public contract catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "schemas"],
  "properties": {
    "version": {"const": 1},
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "schemaRef"],
        "properties": {
          "name": {"type": "string", "enum": ["DatasetSemanticProfile", "TaskSemanticProfile", "DatasetTaskMatchResult", "ProfileJobRequest", "ProfileJobResponse", "ProfileJobGetResponse", "ProfileJobCancelResponse", "MatchJobRequest", "MatchJobResponse", "MatchJobGetResponse", "TaskProfileCreateRequest", "TaskProfileCreateResponse", "ErrorEnvelope", "SseEvent", "VlmConfiguration"]},
          "schemaRef": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
