{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodelmatch.local/schemas/semantic/v1/dataset-semantic-profile.schema.json",
  "title": "DatasetSemanticProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "resourceId", "snapshotRevision", "generator", "structuralSemantics", "contentSemantics", "sampleRefs", "observations", "samplingSummary", "claims", "evidence", "unresolved", "generatedAt"],
  "properties": {
    "version": {"const": 1},
    "resourceId": {"$ref": "common.schema.json#/$defs/id"},
    "snapshotRevision": {"$ref": "common.schema.json#/$defs/revision"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileBuilderVersion", "samplingPolicyVersion", "aggregationRuleVersion", "configurationFingerprint"],
      "properties": {
        "profileBuilderVersion": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "samplingPolicyVersion": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "aggregationRuleVersion": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "configurationFingerprint": {"$ref": "common.schema.json#/$defs/fingerprint"}
      }
    },
    "structuralSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "modalities", "sampleOrganization", "temporalStructure", "supervision", "annotationSemantics", "resourceRoles", "resourceRelations"],
      "properties": {
        "tasks": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/taskFamily"}, "uniqueItems": true},
        "modalities": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/datasetModality"}, "uniqueItems": true},
        "sampleOrganization": {"type": "string", "enum": ["independent_image", "image_sequence", "video", "mixed", "UNKNOWN"]},
        "temporalStructure": {"type": "string", "enum": ["none", "sequence", "video", "mixed", "UNKNOWN"]},
        "supervision": {"type": "array", "items": {"type": "string", "enum": ["class_label", "bbox", "track", "semantic_mask", "instance_mask", "keypoints", "action_label", "temporal_segment", "anomaly_label", "identity", "pair_ranking"]}, "uniqueItems": true},
        "annotationSemantics": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
        "resourceRoles": {"type": "array", "items": {"type": "string", "enum": ["media", "annotation", "metadata", "documentation", "split_definition"]}, "uniqueItems": true},
        "resourceRelations": {"type": "array", "items": {"type": "string", "enum": ["image_to_annotation", "frame_to_track", "video_to_clip_label", "identity_to_camera", "UNKNOWN"]}, "uniqueItems": true}
      }
    },
    "contentSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectCategories", "environments", "viewpoints", "targetScale", "objectDensity", "occlusion", "illumination", "cameraMotion", "targetMotion", "taskSpecificSemantics"],
      "properties": {
        "objectCategories": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
        "environments": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
        "viewpoints": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
        "targetScale": {"$ref": "common.schema.json#/$defs/id"},
        "objectDensity": {"$ref": "common.schema.json#/$defs/id"},
        "occlusion": {"$ref": "common.schema.json#/$defs/id"},
        "illumination": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
        "cameraMotion": {"$ref": "common.schema.json#/$defs/id"},
        "targetMotion": {"$ref": "common.schema.json#/$defs/id"},
        "taskSpecificSemantics": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/taskSpecificSemantic"}}
      }
    },
    "sampleRefs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sampleRef"}, "uniqueItems": true},
    "observations": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/visualObservation"}, "uniqueItems": true},
    "samplingSummary": {"$ref": "common.schema.json#/$defs/samplingSummary"},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/semanticClaim"}, "uniqueItems": true},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/evidence"}, "uniqueItems": true},
    "unresolved": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/unresolvedField"}},
    "generatedAt": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
