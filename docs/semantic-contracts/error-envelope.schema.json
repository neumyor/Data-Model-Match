{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodelmatch.local/schemas/semantic/v1/error-envelope.schema.json",
  "title": "Structured error envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "error"],
  "properties": {
    "version": {"const": 1},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"$ref": "common.schema.json#/$defs/errorCode"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024},
        "retryable": {"type": "boolean"},
        "requestId": {"$ref": "common.schema.json#/$defs/id"},
        "jobId": {"$ref": "common.schema.json#/$defs/id"},
        "details": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "reason"],
            "properties": {
              "field": {"type": "string", "minLength": 1, "maxLength": 256},
              "reason": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          }
        }
      }
    }
  }
}
