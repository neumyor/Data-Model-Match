{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodelmatch.local/schemas/semantic/v1/match-job.schema.json",
  "title": "Dataset task match job API v1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "taskProfileId", "taskProfileRevision", "datasetResourceIds", "matchingRuleVersion", "weightConfigurationFingerprint"],
      "properties": {
        "version": {"const": 1},
        "taskProfileId": {"$ref": "common.schema.json#/$defs/id"},
        "taskProfileRevision": {"$ref": "common.schema.json#/$defs/revision"},
        "datasetResourceIds": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "common.schema.json#/$defs/id"}, "uniqueItems": true},
        "matchingRuleVersion": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "weightConfigurationFingerprint": {"$ref": "common.schema.json#/$defs/fingerprint"},
        "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "job"],
      "properties": {
        "version": {"const": 1},
        "job": {"allOf": [{"$ref": "common.schema.json#/$defs/job"}, {"properties": {"jobType": {"const": "match"}}}]}
      }
    },
    "getResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "job", "results"],
      "properties": {
        "version": {"const": 1},
        "job": {"allOf": [{"$ref": "common.schema.json#/$defs/job"}, {"properties": {"jobType": {"const": "match"}}}]},
        "results": {"type": "array", "items": {"$ref": "dataset-task-match-result.schema.json"}}
      }
    }
  }
}
