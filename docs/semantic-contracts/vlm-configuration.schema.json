{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datamodelmatch.local/schemas/semantic/v1/vlm-configuration.schema.json",
  "title": "VLM configuration extension v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "provider", "endpoint", "apiKey", "model", "imageInput", "videoInput", "limits", "retry"],
  "properties": {
    "version": {"const": 1},
    "provider": {"type": "string", "minLength": 1, "maxLength": 64},
    "endpoint": {"type": "string", "format": "uri", "minLength": 1, "maxLength": 2048},
    "apiKey": {"type": "string", "minLength": 1, "maxLength": 4096, "writeOnly": true},
    "model": {"type": "string", "minLength": 1, "maxLength": 256},
    "imageInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "maxBytes"],
      "properties": {
        "formats": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["jpeg", "png", "webp"]}, "uniqueItems": true},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 52428800}
      }
    },
    "videoInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "formats", "maxBytes", "maxDurationMs"],
      "properties": {
        "mode": {"const": "frames_only"},
        "formats": {"type": "array", "items": {"type": "string", "enum": ["mp4", "webm", "mov"]}, "uniqueItems": true},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 524288000},
        "maxDurationMs": {"type": "integer", "minimum": 1, "maximum": 600000}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxCallsPerStage", "maxCostUsdPerJob"],
      "properties": {
        "timeoutMs": {"type": "integer", "minimum": 1000, "maximum": 300000},
        "maxCallsPerStage": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxCostUsdPerJob": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "baseDelayMs"],
      "properties": {
        "maxAttempts": {"type": "integer", "minimum": 0, "maximum": 5},
        "baseDelayMs": {"type": "integer", "minimum": 100, "maximum": 60000}
      }
    }
  }
}
