{
  "version": 1,
  "id": "crm",
  "name": "CRM",
  "description": "Customer relationship model",
  "entities": [
    {
      "id": "customer",
      "name": "Customer",
      "description": "Customer master data",
      "fields": [
        {
          "id": "user_id",
          "name": "userId",
          "dataType": "string",
          "nullable": false,
          "description": "Unique user identifier"
        },
        {
          "id": "full_name",
          "name": "fullName",
          "dataType": "string",
          "nullable": false,
          "description": "Customer's full name"
        },
        {
          "id": "email_address",
          "name": "emailAddress",
          "dataType": "string",
          "nullable": false,
          "description": "Customer email address"
        },
        {
          "id": "signup_timestamp",
          "name": "signupTimestamp",
          "dataType": "datetime",
          "nullable": false,
          "description": "Account signup time"
        }
      ]
    }
  ]
}
